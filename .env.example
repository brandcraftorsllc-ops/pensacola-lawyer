# Public canonical domain (no trailing slash), e.g. https://www.example.com
NEXT_PUBLIC_SITE_URL=

# SMTP settings used by /api/contact
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
TO_EMAIL=
FROM_EMAIL=
FROM_NAME=Law Office of James M. Burns

# Optional request throttling; defaults to 5 submissions per 15 minutes/IP
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=900000
